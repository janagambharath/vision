DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"
REDIS_URL="redis://default:PASSWORD@HOST:PORT"
# Local development may keep this false or unset. Production always requires
# Redis and fails public mutations closed if Redis is unavailable.
REQUIRE_REDIS_FOR_RATE_LIMITS="false"
AUTH_SECRET="replace-with-railway-secret"
AUTH_URL="https://visionvistara.online"
NEXTAUTH_SECRET="same-value-as-auth-secret-for-compatibility"
NEXTAUTH_URL="https://visionvistara.online"
# Google customer sign-in. In Google Cloud, add this redirect URI:
# https://visionvistara.online/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_SEED_EMAIL="admin@visionvistara.online"
ADMIN_SEED_PASSWORD="replace-before-seeding"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# The storefront is COD-only. Razorpay credentials are not required for new
# orders. Do not add a Razorpay webhook for this launch.
# Gemini AI try-on. Image generation requires a Gemini project with available
# paid-tier quota. Never expose this key with NEXT_PUBLIC_.
GEMINI_API_KEY=""
GEMINI_TRY_ON_MODEL="gemini-3.1-flash-lite-image"
# Optional per-preview USD estimate shown to admins. Leave empty to show that
# the provider price has not been configured rather than inventing a cost.
GEMINI_TRY_ON_ESTIMATED_COST_USD=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Vision Vistara Clinic"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
RESEND_API_KEY=""
CLINIC_PHONE="7842938316"
OPENROUTER_API_KEY=""
OPENROUTER_PRODUCT_ENRICHMENT_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"
OPENROUTER_PRODUCT_ENRICHMENT_FALLBACK_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_SITE_URL="https://visionvistara.online"
NEXT_PUBLIC_SITE_URL="https://visionvistara.online"
# Release-gate attestations. Set these only after completing the real checks;
# `npm run ops:preflight -- --live --strict` enforces freshness without printing secrets.
PRODUCTION_WORKERS_VERIFIED_AT=""
PRODUCTION_BACKUP_RESTORE_VERIFIED_AT=""
PRODUCTION_PROVIDER_CANARY_VERIFIED_AT=""
